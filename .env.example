# Zunia mobile — local secrets (do not commit real values)

# WalletConnect Cloud → https://cloud.walletconnect.com
WALLETCONNECT_PROJECT_ID=

# Optional Apple Team ID for Universal Links (AASA appID = TEAMID.bundleId)
APPLE_TEAM_ID=

# Optional: release signing SHA-256 fingerprints for Android App Links
# ANDROID_SHA256_CERT_FINGERPRINTS=

# Pin for scripts/fetch-native.sh (zunia-core GitHub Release tag)
# ZUNIA_CORE_TAG=v0.1.0
