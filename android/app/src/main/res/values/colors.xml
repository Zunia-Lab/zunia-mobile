<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch background, light appearance (paper). values-night/ holds the dark
         one. Flutter's first frame paints the same colour, read from the system
         appearance, so the splash hands over without a change. -->
    <color name="zunia_splash_bg">#F1F0EE</color>
    <!-- Behind Flutter once it runs. Only ever seen if the surface is not ready
         (a resume, a resize), so it matches the app's default dark theme rather
         than the system appearance. -->
    <color name="zunia_window_bg">#0B0A09</color>
    <color name="zunia_accent">#FF1B0C</color>
</resources>
