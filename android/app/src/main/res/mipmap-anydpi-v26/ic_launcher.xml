<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8+): the brand gradient tile under the white mark,
     which the launcher masks and moves. The same mark is the Android 13+
     themed-icon layer: the system reads only its alpha and tints it.
     mipmap-*dpi/ic_launcher.png stays the icon for Android 7 and older. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
