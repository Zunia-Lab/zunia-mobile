<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- values/styles.xml, plus a navigation bar in the launch background with
         icons that read on it (windowLightNavigationBar is API 27). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/zunia_splash_bg</item>
        <item name="android:windowLightStatusBar">@bool/zunia_light_system_bars</item>
        <item name="android:navigationBarColor">@color/zunia_splash_bg</item>
        <item name="android:windowLightNavigationBar">@bool/zunia_light_system_bars</item>
    </style>
</resources>
