<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Launch screen: the brand mark (LaunchMark, 96 x 120 pt, from scripts/brand-assets.py)
  centred on the whole screen over LaunchBackground (paper in light appearance, ink in
  dark). Flutter's SplashScreen paints its first frame identically, so the 0.2 s fade
  FlutterViewController plays when it removes this view changes nothing on screen.
  Keep the size and centring in step with lib/screens/splash_screen.dart.
-->
